# Telegram Bot Token (olinadi @BotFather dan)
BOT_TOKEN=your_telegram_bot_token_here

# Google Gemini API Key (olinadi https://aistudio.google.com/ dan)
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini Model (Gemini 3.5 Flash Lite yoki boshqa variantlar)
# Masalan: gemini-3.5-flash-lite, gemini-2.5-flash-lite, gemini-2.0-flash
GEMINI_MODEL=gemini-3.5-flash-lite

# Birlamchi yozuv: "latin" (Lotin yozuvi) yoki "cyrillic" (Кирилл ёзуви) yoki "auto"
DEFAULT_SCRIPT=latin
